{
  "site": "acompio",
  "domain": "acompio.com",
  "vault_item": "SCC - acompio.com",
  "mail": {"sender": "acompio", "link_re": "https://account\\.acompio\\.com/confirm\\.php\\?code=[0-9a-f]+"},
  "notes": "b12. Account at account.acompio.com, then a company wizard (Category, Branches/Employees, Contact, Description, Summary). The Turnstile on signup passed by itself in the build Chrome in batch 12 (0 solves); if it does not, add solve_captcha after the stop marker. Branches=1 and Employees=1-10 are Nate's ruling (SCC is a one-person business). The 'Proceed to Next' button can stay disabled after the selects: click_text force:true enables it. Contact/Description/Summary were NEVER reached in batch 12, so those steps are list_fields discovery: run once with --only, read the fields, then write the fills into this file. Logo: not attempted.",
  "steps": [
    {"name": "open_signup", "do": "open", "url": "https://account.acompio.com/signup.php?source=8", "wall_seconds": 90,
     "expect": ["select[name=user-gender]", "select[name=user-language]", "input[name=first_name]", "input[name=last_name]", "input[name=mailadress]", "input[name=password]", "#terms_accepted"]},
    {"name": "gender_first_option", "do": "select_native", "selector": "select[name=user-gender]", "index": 0},
    {"name": "language", "do": "select_native", "selector": "select[name=user-language]", "label": "English"},
    {"name": "first", "do": "fill", "selector": "input[name=first_name]", "key": "first"},
    {"name": "last", "do": "fill", "selector": "input[name=last_name]", "key": "last"},
    {"name": "email", "do": "fill", "selector": "input[name=mailadress]", "key": "email"},
    {"name": "password", "do": "vault_fill", "selector": "input[name=password]", "url": "{current}"},
    {"name": "terms", "do": "check", "selector": "#terms_accepted", "js": true},
    {"do": "stop_before_submit"},
    {"name": "submit_signup", "do": "click", "selector": "button[type=submit]", "submit": true, "settle_ms": 5000},
    {"name": "confirm_mail", "do": "wait_mail"},
    {"name": "login_user", "do": "fill", "selector": "input[name=user]", "key": "email"},
    {"name": "login_password", "do": "vault_fill", "selector": "input[name=password]", "url": "{current}"},
    {"name": "login", "do": "click_text", "text": "Login", "tag": "button,input[type=submit]", "submit": true, "settle_ms": 6000},
    {"name": "add_company", "do": "click_text", "text": "Add new company", "tag": "button,a", "settle_ms": 2500},
    {"name": "company_name", "do": "fill", "selector": "#company-name", "key": "name"},
    {"name": "country", "do": "select_native", "selector": "#select-country", "label": "United States"},
    {"name": "city_zip", "do": "type_pick", "selector": "#selected-city", "key": "zip", "pick_text": "{zip} {city} ({state_name})", "delay_ms": 120, "settle_ms": 3000},
    {"name": "street", "do": "fill", "selector": "#address-street", "key": "street"},
    {"name": "next_address", "do": "click_text", "text": "Proceed to Next", "tag": "button,a", "settle_ms": 5000},
    {"name": "category", "do": "type_pick", "selector": "input[placeholder='Search Category']", "value": "business management consult", "pick_text": "Business management consulting services", "delay_ms": 90, "settle_ms": 1800},
    {"name": "next_category", "do": "click_text", "text": "Proceed to Next", "tag": "button,a", "settle_ms": 4000},
    {"name": "branches", "do": "select_native", "selector": "[name=branches]", "label": "1"},
    {"name": "employees", "do": "select_native", "selector": "[name=employees]", "label": "1-10"},
    {"name": "next_branches", "do": "click_text", "text": "Proceed to Next", "tag": "button,a", "force": true, "settle_ms": 4000},
    {"name": "discover_contact", "do": "list_fields"}
  ]
}
