{
  "site": "acompio",
  "domain": "acompio.com",
  "record": "created-unlisted",
  "vault_item": "SCC - acompio.com",
  "mail": {
    "sender": "acompio",
    "link_re": "https://account\\.acompio\\.com/confirm\\.php\\?code=[0-9a-f]+"
  },
  "notes": "t_03a74bae (batch 17 live fixes folded in). ONE spec, two branches. `--has-account` (the Directory account exists: SCC - acompio in the vault): the `login` step signs in at account.acompio.com/login.php and the signup + confirm-mail steps are skipped. Without it: signup (Turnstile passed by itself in the build Chrome, 0 solves), the confirm mail, then the login form. Wizard, as seen live in batch 17: remove `.fullscreen-notification` before 'Add new company' (it covers the button); Address 'Proceed to Next' is an <a> that needs force:true; the selects are #branches / #employees (1 and 1-10, Nate's ruling); a Social step sits between Branches and Contact (Proceed with nothing typed); Contact (#company-phone/#company-contact/#company-webpage/#company-email); Description (SunEditor .se-wrapper-wysiwyg) types the canonical {description_long} (job/description_long.py: 100 to 300 chars, no address, no phone, no hours; acompio rejected listing 47872152 as 'Insufficient description'); Finish Listing. A FAILED run leaves a draft company: 'Add new company' resumes it at the step it stopped on, so use acompio_resume.json to finish a draft instead of retyping. Result of a full run: dashboard 'pending', the free tier shows 'Address not listed', so the row is created-unlisted, never submitted. Logo: not attempted. Premium upsell: not taken. Merged from acompio_discover / _existing / _final (deleted: diagnostic and subset copies of this flow).",
  "steps": [
    {
      "name": "open_signup",
      "do": "open",
      "url": "https://account.acompio.com/signup.php?source=8",
      "wall_seconds": 90,
      "expect": [
        "select[name=user-gender]",
        "select[name=user-language]",
        "input[name=first_name]",
        "input[name=last_name]",
        "input[name=mailadress]",
        "input[name=password]",
        "#terms_accepted"
      ],
      "when": "new_account"
    },
    {
      "name": "gender_first_option",
      "do": "select_native",
      "selector": "select[name=user-gender]",
      "index": 0,
      "when": "new_account"
    },
    {
      "name": "language",
      "do": "select_native",
      "selector": "select[name=user-language]",
      "label": "English",
      "when": "new_account"
    },
    {
      "name": "first",
      "do": "fill",
      "selector": "input[name=first_name]",
      "key": "first",
      "when": "new_account"
    },
    {
      "name": "last",
      "do": "fill",
      "selector": "input[name=last_name]",
      "key": "last",
      "when": "new_account"
    },
    {
      "name": "email",
      "do": "fill",
      "selector": "input[name=mailadress]",
      "key": "email",
      "when": "new_account"
    },
    {
      "name": "password",
      "do": "vault_fill",
      "selector": "input[name=password]",
      "url": "{current}",
      "when": "new_account"
    },
    {
      "name": "terms",
      "do": "check",
      "selector": "#terms_accepted",
      "js": true,
      "when": "new_account"
    },
    {
      "do": "stop_before_submit",
      "when": "new_account"
    },
    {
      "name": "submit_signup",
      "do": "click",
      "selector": "button[type=submit]",
      "submit": true,
      "settle_ms": 5000,
      "when": "new_account"
    },
    {
      "name": "confirm_mail",
      "do": "wait_mail",
      "when": "new_account"
    },
    {
      "name": "sign_in",
      "do": "login",
      "url": "https://account.acompio.com/login.php",
      "user_selector": "input[name=user]",
      "password_selector": "input[name=password]",
      "wall_seconds": 90,
      "settle_ms": 6000,
      "when": "has_account"
    },
    {
      "name": "login_user",
      "do": "fill",
      "selector": "input[name=user]",
      "key": "email",
      "when": "new_account"
    },
    {
      "name": "login_password",
      "do": "vault_fill",
      "selector": "input[name=password]",
      "url": "{current}",
      "when": "new_account"
    },
    {
      "name": "login",
      "do": "click_text",
      "text": "Login",
      "tag": "button,input[type=submit]",
      "submit": true,
      "settle_ms": 6000,
      "when": "new_account"
    },
    {
      "name": "clear_overlay_pre",
      "do": "remove",
      "selector": ".fullscreen-notification"
    },
    {
      "name": "wait_pre",
      "do": "wait",
      "ms": 1500
    },
    {
      "name": "add_company",
      "do": "click_text",
      "text": "Add new company",
      "tag": "button,a",
      "settle_ms": 2500,
      "optional": false
    },
    {
      "name": "company_name",
      "do": "fill",
      "selector": "#company-name",
      "key": "name"
    },
    {
      "name": "country",
      "do": "select_native",
      "selector": "#select-country",
      "label": "United States"
    },
    {
      "name": "clear_overlay_0",
      "do": "remove",
      "selector": ".fullscreen-notification"
    },
    {
      "name": "city_zip",
      "do": "type_pick",
      "selector": "#selected-city",
      "key": "zip",
      "pick_text": "{zip} {city} ({state_name})",
      "delay_ms": 120,
      "settle_ms": 3000
    },
    {
      "name": "street",
      "do": "fill",
      "selector": "#address-street",
      "key": "street"
    },
    {
      "name": "next_address",
      "do": "click_text",
      "text": "Proceed to Next",
      "tag": "button,a",
      "force": true,
      "settle_ms": 5000
    },
    {
      "name": "category",
      "do": "type_pick",
      "selector": "input[placeholder='Search Category']",
      "value": "business management consult",
      "pick_text": "Business management consulting services",
      "delay_ms": 90,
      "settle_ms": 1800
    },
    {
      "name": "next_category",
      "do": "click_text",
      "text": "Proceed to Next",
      "tag": "button,a",
      "settle_ms": 4000
    },
    {
      "name": "branches",
      "do": "select_native",
      "selector": "#branches",
      "label": "1"
    },
    {
      "name": "employees",
      "do": "select_native",
      "selector": "#employees",
      "label": "1-10"
    },
    {
      "name": "next_branches",
      "do": "click_text",
      "text": "Proceed to Next",
      "tag": "button,a",
      "force": true,
      "settle_ms": 4000
    },
    {
      "name": "next_social",
      "do": "click_text",
      "text": "Proceed to Next",
      "tag": "button,a",
      "force": true,
      "settle_ms": 4000
    },
    {
      "name": "clear_overlay",
      "do": "remove",
      "selector": ".fullscreen-notification"
    },
    {
      "name": "contact_phone",
      "do": "fill",
      "selector": "#company-phone",
      "key": "phone"
    },
    {
      "name": "contact_name",
      "do": "fill",
      "selector": "#company-contact",
      "key": "contact"
    },
    {
      "name": "contact_web",
      "do": "fill",
      "selector": "#company-webpage",
      "key": "site"
    },
    {
      "name": "contact_email",
      "do": "fill",
      "selector": "#company-email",
      "key": "email"
    },
    {
      "name": "next_contact",
      "do": "click_text",
      "text": "Proceed to Next",
      "tag": "button,a",
      "force": true,
      "settle_ms": 4000
    },
    {
      "name": "clear_overlay_2",
      "do": "remove",
      "selector": ".fullscreen-notification"
    },
    {
      "name": "description",
      "do": "type_text",
      "selector": ".se-wrapper-wysiwyg",
      "value": "{description_long}",
      "delay_ms": 10
    },
    {
      "name": "next_description",
      "do": "click_text",
      "text": "Proceed to Next",
      "tag": "button,a",
      "force": true,
      "settle_ms": 4000
    },
    {
      "do": "stop_before_submit"
    },
    {
      "name": "finish_listing",
      "do": "click_text",
      "text": "Finish Listing",
      "tag": "button,a,input[type=submit]",
      "submit": true,
      "settle_ms": 5000
    }
  ]
}
