{
  "site": "citylocalpro_resend",
  "domain": "citylocalpro.com",
  "record": "none",
  "vault_item": "SCC - citylocalpro.com",
  "notes": "Batch 22 observed 2026-10-28: login input[name=login], #loginBtn; unverified account remains on login page and offers Re-send. One resend returned RESULT=limit; next eligible 2026-10-29, one resend per day only. --dry-run stops before login and resend. Read result classes limit/sent/unknown; never infer delivery from a click. Existing vault item only; no duplicate account.",
  "steps": [
