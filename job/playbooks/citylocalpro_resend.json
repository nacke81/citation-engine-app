      "name": "open_login",
      "do": "open",
      "url": "https://citylocalpro.com/login",
      "expect": ["input[name=login]"]
    },
    {"name":"fill_email","do":"fill","selector":"input[name=login]","key":"email"},
    {"name":"fill_password","do":"vault_fill","selector":"input[name=password]","url":"https://citylocalpro.com/login"},
    {
      "do": "stop_before_submit"
    },
    {"name":"login_attempt","do":"click","selector":"#loginBtn","submit":true,"frames":false},
    {"name":"wait_banner","do":"wait","ms":2500},
    {
      "name": "resend_once",
      "do": "click_text",
      "text": "Re-send",
      "tag": "a,button",
      "exact": true,
      "submit": true,
      "snapshot_before": true,
      "settle_ms": 4000
    },
    {
      "name": "read_result",
      "do": "read_result",
      "new_only": true,
      "settle_ms": 1500,
      "classes": {
        "limit": [
          "24 ?h",
          "24 hours",
          "too many",
          "limit",
          "try again (later|tomorrow)",
          "already (been )?sent (today|recently)",
          "wait .{0,20}before"
        ],
        "sent": [
          "(has|have) been sent",
          "(email|mail|link) (was |is )?sent",
          "we('| ha)ve sent",
          "check your (email|inbox)",
          "verification (email|mail|link) (sent|re-?sent)",
          "re-?sent"
        ]
      }
    }
  ]
