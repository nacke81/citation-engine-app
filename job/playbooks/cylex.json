{
  "site": "cylex",
  "domain": "cylex.us",
  "record": "none",
  "vault_item": "SCC - cylex.us",
  "notes": "Batch 22 observed 10/28: Cloudflare absent; email-first Continue, name/password, form reCAPTCHA, Register, optional My e-mail is correct, email code typed but NOT submitted. Existing vault item SCC - cylex.us only. Two CapSolver calls already spent; row solve log and 2 prior wall days must persist. This spec documents observed signup stages, NOT a safe instruction to re-register: on resume Lis must find the existing account/code stage, verify it live, and stop if page state differs. No business-form controls proven; no listing exists. A typed code is not server verification; only an explicit success response AFTER submit can justify a verified account. Never run registration again just to exercise this spec.",
  "mail": {
    "sender": "cylex",
    "link_re": "(?:code|verification code)[^0-9A-Za-z]{0,20}(?P<v>[0-9]{4,8})"
  },
  "steps": [
    {
      "name": "open_register",
      "do": "open",
      "url": "https://www.cylex.us.com/",
      "wall_seconds": 60,
      "expect": ["body"]
    },
    {
      "name": "discover_form",
      "do": "list_fields"
    },
    {
      "name": "cookies",
      "do": "click_text",
      "text": "Do not consent",
      "tag": "button",
      "optional": true,
      "settle_ms": 500
    },
    {
      "name": "open_register_form_UNPROVEN",
      "do": "click_text",
      "text": "Register",
      "tag": "a,button",
      "settle_ms": 2500
    },
    {
      "name": "email_first",
      "do": "fill",
      "selector": "input[type=email], input[name*=mail i]",
      "key": "email"
    },
    {"name":"terms","do":"check","selector":"input[type=checkbox]","js":true},
    {"do":"stop_before_submit"},
    {"name":"continue_email","do":"click","selector":"button:has-text('Continue')","submit":true,"settle_ms":5000},
    {"name":"full_name","do":"fill","selector":"input[placeholder*='First']","key":"contact"},
    {"name":"password","do":"vault_fill","selector":"input[type=password]","url":"{current}"},
    {"name":"solve_recaptcha","do":"solve_captcha"},
    {"name":"submit_registration","do":"click","selector":"button:has-text('Register') >> visible=true","submit":true,"settle_ms":5000},
    {"name":"confirm_email","do":"click_text","text":"My e-mail is correct","tag":"a,button","optional":true,"submit":true,"settle_ms":4000},
    {"name":"code_entry_only","do":"wait_mail","as":"code","selector":"input[name*=code i]"},
    {"name":"inspect_code_page","do":"list_fields"},
    {"name":"submit_code_UNPROVEN","do":"click","selector":"button[type=submit] >> visible=true","submit":true,"settle_ms":5000},
    {"name":"require_server_confirmation_UNPROVEN","do":"read_text","expect_any":["email verified","account verified"]},
    {"name":"business_form_UNPROVEN","do":"list_fields"}
  ]
}
